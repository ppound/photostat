# GPU image for the PhotoStat faces service (CUDA 12.6 + cuDNN 9).
# Requires the NVIDIA Container Toolkit on the host and `--gpus`/device
# reservations at run time (see docker-compose.gpu.yml).
FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive \
    PHOTOSTAT_FACES_MODEL_ROOT=/models

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip build-essential cmake libglib2.0-0 libgl1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY docker/faces/requirements-gpu.txt requirements.txt
RUN pip3 install --no-cache-dir -r requirements.txt

COPY src/main/resources/photostat_faces.py .
COPY docker/faces/server.py .

VOLUME ["/models"]
EXPOSE 8001

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8001"]
